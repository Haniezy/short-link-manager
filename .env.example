# Neon Postgres database connection string (serverless / pooled)
# Get it from: Neon dashboard -> Project -> Connect
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Random 64-char hex secret used to sign the auth session cookie.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=""

# Public base URL of the app. Use http://localhost:3000 locally,
# and your Vercel deployment URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"