# =====================================================================
# ShortLink — Environment Variables
#
# Two modes are auto-detected based on which vars are set:
#   • Neon mode:       DATABASE_URL + NEON_AUTH_BASE_URL + NEON_AUTH_COOKIE_SECRET
#   • Local mode:      just NEXT_PUBLIC_BASE_URL + LOCAL_AUTH_SECRET
#                      (DATABASE_URL absent → PGlite + local auth)
# =====================================================================

# Public base URL of the app. Used to build copyable short links.
# Local dev:
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Production (Vercel): set this in the Vercel project environment variables.
# NEXT_PUBLIC_BASE_URL="https://your-app.vercel.app"

# ---- Neon mode (set these to switch back to Neon) ----
# Neon Postgres connection string (from your Neon project dashboard).
# Pooled ("-pooler") or direct both work; this app uses the HTTP driver.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# Base URL of your Neon Auth instance (your Neon project URL, e.g. https://ep-xxxx.neon.tech)
NEON_AUTH_BASE_URL="https://your-project.neon.tech"
# Secret for signing session cookies (min 32 chars). Generate one, e.g.: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=""

# ---- Local mode (only needed when DATABASE_URL is absent) ----
# Local auth session signing secret (min 32 chars). Generate with: openssl rand -hex 32
LOCAL_AUTH_SECRET=""
# Directory where the local PGlite Postgres database is persisted.
PGLOCAL_DIR=".pglocal"
