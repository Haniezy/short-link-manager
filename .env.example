# Always "neon" in production. Use "pglite" only for local embedded Postgres (never deployed).
DATABASE_DRIVER="neon"

# Neon Console -> project -> Connect. Use the pooled (-pooler) host for the serverless runtime,
# and make sure it points at the same branch that Neon Auth is enabled on.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local embedded Postgres only; ignored when DATABASE_DRIVER is "neon".
PGLITE_DATA_DIR="./.pglite"

# Neon Console -> Auth -> enable Auth on the selected branch -> copy Auth URL.
# Must be https and must match the branch behind DATABASE_URL.
NEON_AUTH_BASE_URL="https://YOUR_AUTH_HOST.neonauth.REGION.aws.neon.tech/neondb/auth"

# Generate a fresh secret for each environment:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Changing it invalidates every existing session.
NEON_AUTH_COOKIE_SECRET=""

# The public origin used to build short links. NEXT_PUBLIC_* values are inlined at BUILD time,
# so on Vercel this must be set for the build as well as the runtime, and it must be the final
# production origin. Add it to Neon Auth's trusted domains too.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
