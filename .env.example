# Neon Console -> project -> Connect. Use the same branch as Neon Auth.
DATABASE_DRIVER="neon"
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# For local embedded Postgres, set DATABASE_DRIVER=pglite; DATABASE_URL is then unused.
PGLITE_DATA_DIR="./.pglite"

# Neon Console -> Auth -> enable Auth on the selected branch -> copy Auth URL.
NEON_AUTH_BASE_URL="https://YOUR_AUTH_HOST.neonauth.REGION.aws.neon.tech/neondb/auth"

# Generate locally: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
NEON_AUTH_COOKIE_SECRET=""

# Add this origin to Neon Auth's trusted domains. Use the Vercel URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
