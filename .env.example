# Required for both local development and production. No offline auth fallback.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
DATABASE_URL="postgresql://user:password@your-neon-host/dbname?sslmode=require"
NEON_AUTH_BASE_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth"
# Generate a secret of at least 32 characters, e.g. openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=""
