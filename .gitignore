# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit .env.example, never real secrets
.env
.env.local
.env.*.local
!.env.example

# local PGlite database directory (created at runtime, never commit data)
/.pglocal

# generated Drizzle migration SQL (regenerate per environment; never commit)
/drizzle

# local-only tooling artifacts — keep files on disk, never commit
/.zcode
/.extract_landing.py
# temporary debug endpoints — delete before shipping
/src/app/api/debug/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
